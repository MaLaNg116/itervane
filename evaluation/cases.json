      "title": "不同任务竞争全局执行槽位",
      "input": { "kind": "scenario", "events": [{ "action": "concurrent-workflows", "data": { "count": 2 } }, { "action": "pause-one-for-human", "data": {} }] },
      "expected": "completed",
      "oracles": ["任何时刻只有一个执行中业务工作流", "审批暂停持久化并释放槽位；恢复重新竞争"]
