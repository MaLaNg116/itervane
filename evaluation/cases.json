      "input": { "kind": "scenario", "events": [{ "action": "expire-and-reassign-run", "data": {} }, { "action": "old-worker-write", "data": { "observation": "stale" } }] },
      "expected": "rejected",
      "oracles": ["失效代次不能提交领域结果或发起新工具", "队列重复投递不增加逻辑操作"]
