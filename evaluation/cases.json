      "title": "批准后调换镜像或关键配置",
      "input": { "kind": "scenario", "events": [{ "action": "human-confirm", "data": { "candidate": "frozen-a" } }, { "action": "replace-candidate-content", "data": { "image": "different-digest", "target": "different-environment" } }] },
      "expected": "blocked",
      "oracles": ["冻结候选不可原地更改", "变化后旧授权无效；下游未接收部署"]
    },
    {
      "id": "G04", "loop": "governance", "split": "development", "phase": "P1", "category": "recovery",
      "title": "取消与后续工具调用竞争",
