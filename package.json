{
  "name": "itervane",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "typecheck": "tsx scripts/typecheck.ts",
    "test": "vitest run",
    "test:integration": "tsx --env-file-if-exists=.env scripts/test-postgres.ts",
    "test:portal": "tsx --env-file-if-exists=.env scripts/test-portal.ts",
    "probe:scanners": "tsx scripts/probe-scanners.ts",
    "probe:model": "tsx --env-file-if-exists=.env packages/verification/src/entries/model.ts",
    "probe:cloud": "tsx --env-file-if-exists=.env packages/verification/src/entries/cloud.ts",
    "probe:runner-vm": "tsx packages/verification/src/entries/runner-vm.ts",
    "probe:komodo": "tsx packages/verification/src/entries/komodo-native.ts",
    "probe:whiskers": "tsx packages/portal/test/native/whiskers.ts",
    "probe:mcp": "tsx packages/verification/src/entries/mcp.ts",
    "probe:evaluation": "tsx packages/verification/src/entries/evaluation.ts",
    "probe:agent": "tsx --env-file-if-exists=.env packages/verification/src/entries/agent.ts",
    "probe:formal-audit": "tsx --env-file-if-exists=.env packages/verification/src/entries/formal-audit.ts",
    "probe:formal-repair": "tsx --env-file-if-exists=.env packages/verification/src/entries/formal-repair.ts",
    "probe:formal-verify": "tsx --env-file-if-exists=.env packages/verification/src/entries/formal-verification.ts",
    "verify:p0": "tsx --env-file-if-exists=.env packages/verification/src/cli.ts readiness",
    "start:api": "tsx --env-file-if-exists=.env packages/control-plane/src/entries/server.ts",
    "build:portal": "pnpm --filter @itervane/portal build",
    "start:worker": "tsx --env-file-if-exists=.env packages/control-plane/src/entries/worker.ts",
    "db:migrate": "tsx --env-file-if-exists=.env packages/control-plane/src/entries/migrate.ts",
    "bootstrap:owner": "tsx --env-file-if-exists=.env packages/control-plane/src/entries/bootstrap.ts",
    "register:release-target": "tsx --env-file-if-exists=.env packages/control-plane/src/entries/register-release-target.ts",
    "check": "tsx scripts/check.ts"
  },
  "devDependencies": {
    "@itervane/contracts": "workspace:*",
    "@itervane/verification": "workspace:*",
    "@itervane/runner": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
