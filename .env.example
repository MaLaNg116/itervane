# Keep real endpoints and credentials in .env (ignored by Git).
# One protocol is selected per probe/task. The first live target is Anthropic-compatible.
MODEL_PROVIDER=anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Read-only SSH probe. Host must already have a verified known_hosts entry.
ITERVANE_VALIDATION_SSH=
ITERVANE_SSH_PORT=22
ITERVANE_SSH_IDENTITY=

# Optional pre-existing disposable PostgreSQL 17 test database.
# When omitted, test:integration starts its own localhost-only Docker container.
DATABASE_URL=
ITERVANE_POSTGRES_IMAGE=postgres:17@sha256:0d938e975177bef9f1f61f3f9dbcf2e0aa0a139568f66d3415ed8892eb97f6ac

# P1-A 控制面：运行账号使用上面的 DATABASE_URL；启动时不自动迁移。
ITERVANE_MIGRATION_DATABASE_URL=
ITERVANE_OIDC_ISSUER=
ITERVANE_OIDC_AUDIENCE=itervane-api
ITERVANE_OWNER_SUBJECT=
ITERVANE_API_HOST=127.0.0.1
ITERVANE_API_PORT=4310

# P1-B canonical MCP resource = ITERVANE_PUBLIC_URL + /mcp.
# Use HTTPS outside loopback; tokens for MCP need this resource audience and scopes.
ITERVANE_PUBLIC_URL=http://127.0.0.1:4310
ITERVANE_WORKER_LEASE_SECONDS=10
ITERVANE_WORKER_POLL_MS=1000

# Optional read-only operations. Set environment ID and fingerprint from the registration receipt.
# Set ITERVANE_OPERATIONS_API_ENABLED=1 only for the API on a qualified installation.
# Set the Whiskers Read key only on the matching Worker.
# ITERVANE_OPERATIONS_API_ENABLED=0
# ITERVANE_OPERATIONS_ENVIRONMENT_ID=
# ITERVANE_OPERATIONS_ENROLLMENT_SHA256=
# ITERVANE_OPERATIONS_WHISKERS_READ_KEY=
# Set the same installed model fingerprint in the API and Worker to admit full read-only diagnoses.
# ITERVANE_OPERATIONS_DIAGNOSIS_PROVIDER_SHA256=

# API only. Opt in to approved restart submission with the active installation document.
# The API verifies the document against the current protected environment and writer registration.
# ITERVANE_RESTART_API_INSTALLATION_FILE=/run/itervane/restart/installation.json

# P3 restart Worker only. Inject the files and credentials into the dedicated process.
# Use the approved release mapping and the registered Whiskers writer generation for this environment.
# ITERVANE_OPERATIONS_RELEASE_TARGET_SHA256=
# ITERVANE_RESTART_INSTALLATION_FILE=/run/itervane/restart/installation.json
# ITERVANE_RESTART_GUARDRAILS_FILE=/run/itervane/restart/guardrails.json
# ITERVANE_RESTART_ROLES_FILE=/run/itervane/restart/roles.json
# ITERVANE_RESTART_WHISKERS_WRITE_KEY=
# ITERVANE_RESTART_KOMODO_READER_ID=
# ITERVANE_RESTART_KOMODO_READER_KEY=
# ITERVANE_RESTART_KOMODO_READER_SECRET=
# ITERVANE_RESTART_PROBE_SECRET=

# P3 restore Worker only. Use the registered deployment writer and a distinct, deployment-scoped reader.
# Also set the operations environment ID, enrollment fingerprint, and release target fingerprint above.
# ITERVANE_RESTORE_KOMODO_WRITER_KEY=
# ITERVANE_RESTORE_KOMODO_WRITER_SECRET=
# ITERVANE_RESTORE_KOMODO_READER_ID=
# ITERVANE_RESTORE_KOMODO_READER_KEY=
# ITERVANE_RESTORE_KOMODO_READER_SECRET=
# ITERVANE_RESTORE_PROBE_SECRET=

# Optional Linux Worker connection to a locally provisioned, verified inspection controller.
# Set all three together. The controller separately allowlists exact registered HTTPS sources.
# ITERVANE_RUNNER_SOCKET=/run/itervane-runner/inspection.sock
# ITERVANE_RUNNER_UID=
# ITERVANE_RUNNER_IMAGE_SHA256=

# Optional formal audit. Select one protocol explicitly and set its three variables above.
# ITERVANE_AUDIT_MODEL_PROVIDER=anthropic
# Formal repair reuses the qualified Runner and configured model. Enable the repair channel on the controller before enabling the Worker.
# ITERVANE_FORMAL_REPAIR=1
# ITERVANE_REPAIR_PROTECTED_PATHS=["platform-tests"]
# Reviewed npm v3 leaf upgrades. Each entry binds advisoryId, name, installedVersion, fixedVersion and integrity (SHA-512 SRI).
# ITERVANE_NPM_REPAIR_APPROVALS=[]
# Formal verification uses a fixed standard application profile and its matching qualified Runner.
# Set this JSON object with id, policySha256, baselineSha256, scannerInputsSha256, runnerImageSha256,
# buildProfileSha256 and ociInputsSha256, plus runStandardBaseline=true and retainStandardImage=true.
# ITERVANE_VERIFICATION_PROFILE=

# P1-C public OIDC client. Leave empty to disable browser sign-in.
# Use Authorization Code + PKCE S256; never put a client secret here.
ITERVANE_PORTAL_CLIENT_ID=
# Only test:portal uses a temporary, trusted, loopback-only identity server.
ITERVANE_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2@sha256:c68e286cacd87b942ac1939a0a1481461109d6acd3a57dc496969a319a76bbf0
