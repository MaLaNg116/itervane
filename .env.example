# Keep real endpoints and credentials in .env (ignored by Git).
# One protocol is selected per probe/task. The first live target is Anthropic-compatible.
MODEL_PROVIDER=anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Read-only SSH probe. Host must already have a verified known_hosts entry.
ITERVANE_VALIDATION_SSH=
ITERVANE_SSH_PORT=22
ITERVANE_SSH_IDENTITY=

# Optional pre-existing disposable PostgreSQL 17 test database.
# When omitted, test:integration starts its own localhost-only Docker container.
DATABASE_URL=
ITERVANE_POSTGRES_IMAGE=postgres:17@sha256:0d938e975177bef9f1f61f3f9dbcf2e0aa0a139568f66d3415ed8892eb97f6ac

# P1-A 控制面：运行账号使用上面的 DATABASE_URL；启动时不自动迁移。
ITERVANE_MIGRATION_DATABASE_URL=
ITERVANE_OIDC_ISSUER=
ITERVANE_OIDC_AUDIENCE=itervane-api
ITERVANE_OWNER_SUBJECT=
ITERVANE_API_HOST=127.0.0.1
ITERVANE_API_PORT=4310

# P1-B canonical MCP resource = ITERVANE_PUBLIC_URL + /mcp.
# Use HTTPS outside loopback; tokens for MCP need this resource audience and scopes.
ITERVANE_PUBLIC_URL=http://127.0.0.1:4310
ITERVANE_WORKER_LEASE_SECONDS=10
ITERVANE_WORKER_POLL_MS=1000

# P1-C public OIDC client. Leave empty to disable browser sign-in.
# Use Authorization Code + PKCE S256; never put a client secret here.
ITERVANE_PORTAL_CLIENT_ID=
# Only test:portal uses a temporary, trusted, loopback-only identity server.
ITERVANE_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2@sha256:c68e286cacd87b942ac1939a0a1481461109d6acd3a57dc496969a319a76bbf0
